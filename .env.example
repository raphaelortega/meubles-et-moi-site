# Configuration Supabase pour Meubles&moi
# Récupérez ces identifiants sur https://supabase.com dans votre projet > Settings > API

# URL de votre projet Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clé anonyme publique (anon public key)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Envoi automatique des devis par e-mail
# (Destinataires par défaut : r.ortega@meubles-et-moi.fr et m.aucourt@meubles-et-moi.fr)
# Recommandé (gratuit jusqu'à 3 000 emails/mois sur https://resend.com) :
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Meubles&moi <contact@meubles-et-moi.fr>

# Alternative Brevo (https://brevo.com) :
# BREVO_API_KEY=xkeysib-your-key-here
